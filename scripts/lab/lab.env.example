# lab.env — paths for the data machine + compute machines setup.
# Copy to scripts/lab/lab.env (git-ignored), edit, and keep it identical on all machines.
#   cp scripts/lab/lab.env.example scripts/lab/lab.env

# Shared storage as seen from every machine.
export CB2_SHARED=/mnt/shared/connectomebench2

# Dataset root (written by the data machine, read by the compute machines). ~235 GB for v2.
export CB2_DATA="$CB2_SHARED/ConnectomeBench2"

# Checkpoints, logs, predictions, tables (written by compute machines).
export CB2_RUNS="$CB2_SHARED/runs"

# ImageNet ViT weights cache on shared storage, so compute machines without internet
# can start training (filled once by setup_compute.sh on a machine with internet).
export TORCH_HOME="$CB2_SHARED/torch_cache"

# HuggingFace cache (download metadata only; the dataset itself goes to CB2_DATA).
export HF_HOME="$CB2_SHARED/hf_cache"
# export HF_TOKEN=hf_xxx            # optional: higher download rate limits

# Python environment of the compute machine. Keep it on LOCAL disk (one per machine);
# a venv on network storage makes every `import torch` slow.
export CB2_VENV="$HOME/.venvs/connectomebench2"

# Optional: a PyTorch wheel index matching the machine's CUDA driver, used only if the
# default PyPI torch cannot see the GPUs, e.g. https://download.pytorch.org/whl/cu121
# export TORCH_INDEX=https://download.pytorch.org/whl/cu121

# Training defaults (override per run on the command line: NGPU=2 bash scripts/lab/train.sh)
export NGPU="${NGPU:-1}"
export MODEL="${MODEL:-vit_b_16}"
export BS="${BS:-256}"            # GLOBAL batch size (paper: 256 ViT-B on 1 GPU, 768 ViT-L on 3)
export EPOCHS="${EPOCHS:-20}"
export WORKERS="${WORKERS:-16}"   # DataLoader workers in total (split across GPUs)
